{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.willpower.dev/resource-manifest/animation-set.schema.json",
  "title": "AnimationSet Resource",
  "$ref": "#/definitions/resource",
  "definitions": {
    "positiveUnsignedInteger": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[0-9]*[1-9][0-9]*$" }
      ]
    },
    "positiveNumber": {
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        {
          "type": "string",
          "pattern": "^\\+?(?=[0-9.]*[1-9])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        }
      ]
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        "value": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/scalar"
        }
      }
    },
    "tagCollection": {
      "oneOf": [
        { "$ref": "#/definitions/tag" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/tag" }
        }
      ]
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Tag"],
      "properties": {
        "Tag": { "$ref": "#/definitions/tagCollection" }
      }
    },
    "explicitFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        "frame": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/unsignedInteger"
        },
        "time": { "$ref": "#/definitions/positiveNumber" },
        "xoff": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer"
        },
        "yoff": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer"
        },
        "Tags": { "$ref": "#/definitions/tags" }
      }
    },
    "imageSetFrameOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame"],
      "properties": {
        "frame": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/unsignedInteger"
        },
        "time": { "$ref": "#/definitions/positiveNumber" },
        "xoff": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer"
        },
        "yoff": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer"
        },
        "Tags": { "$ref": "#/definitions/tags" }
      }
    },
    "explicitFrameCollection": {
      "oneOf": [
        { "$ref": "#/definitions/explicitFrame" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/explicitFrame" }
        }
      ]
    },
    "imageSetFrameOverrideCollection": {
      "oneOf": [
        { "$ref": "#/definitions/imageSetFrameOverride" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/imageSetFrameOverride" }
        }
      ]
    },
    "explicitFrames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Frame"],
      "properties": {
        "time": { "$ref": "#/definitions/positiveNumber" },
        "xoff": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer"
        },
        "yoff": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer"
        },
        "Frame": { "$ref": "#/definitions/explicitFrameCollection" }
      }
    },
    "imageSetFrames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageset"],
      "properties": {
        "imageset": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        "count": { "$ref": "#/definitions/positiveUnsignedInteger" },
        "time": { "$ref": "#/definitions/positiveNumber" },
        "xoff": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer"
        },
        "yoff": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer"
        },
        "Frame": { "$ref": "#/definitions/imageSetFrameOverrideCollection" }
      }
    },
    "frames": {
      "oneOf": [
        { "$ref": "#/definitions/explicitFrames" },
        { "$ref": "#/definitions/imageSetFrames" }
      ]
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "Frames"],
      "properties": {
        "name": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        "loopStyle": { "enum": ["forwards", "once", "pingpong"] },
        "Frames": { "$ref": "#/definitions/frames" }
      }
    },
    "animationCollection": {
      "oneOf": [
        { "$ref": "#/definitions/animation" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/animation" }
        }
      ]
    },
    "animations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Animation"],
      "properties": {
        "Animation": { "$ref": "#/definitions/animationCollection" }
      }
    },
    "defaultDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Animations"],
      "properties": {
        "Animations": { "$ref": "#/definitions/animations" }
      }
    },
    "specializedDefinition": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/definition" },
        { "required": ["factory"] }
      ]
    },
    "definition": {
      "oneOf": [
        { "$ref": "#/definitions/defaultDefinition" },
        { "$ref": "#/definitions/specializedDefinition" }
      ]
    },
    "definitionCollection": {
      "oneOf": [
        { "$ref": "#/definitions/defaultDefinition" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/definition" },
          "contains": { "$ref": "#/definitions/defaultDefinition" }
        }
      ]
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Definition"],
      "properties": {
        "Definition": { "$ref": "#/definitions/definitionCollection" }
      }
    },
    "imageDependency": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/dependentResource" },
        {
          "required": ["id"],
          "properties": {
            "id": { "enum": ["Image"] }
          }
        }
      ]
    },
    "imageDependencyCollection": {
      "oneOf": [
        { "$ref": "#/definitions/imageDependency" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/imageDependency" }
        }
      ]
    },
    "dependentResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DependentResource"],
      "properties": {
        "DependentResource": { "$ref": "#/definitions/imageDependencyCollection" }
      }
    },
    "resource": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/resource" },
        {
          "required": ["name", "DependentResources", "Definitions"],
          "properties": {
            "type": { "enum": ["AnimationSet"] },
            "DependentResources": { "$ref": "#/definitions/dependentResources" },
            "Definitions": { "$ref": "#/definitions/definitions" }
          },
          "not": {
            "anyOf": [
              { "required": ["location"] },
              { "required": ["Option"] }
            ]
          }
        }
      ]
    }
  }
}
