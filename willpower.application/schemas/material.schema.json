{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.willpower.dev/resource-manifest/material.schema.json",
  "title": "Material Resource",
  "$ref": "#/definitions/resource",
  "definitions": {
    "nonEmptyScalar": {
      "oneOf": [
        {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "resourceTexture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampler", "type", "value"],
      "properties": {
        "sampler": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        "type": { "enum": ["resource"] },
        "value": { "$ref": "#/definitions/nonEmptyScalar" }
      }
    },
    "defaultTexture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampler", "type"],
      "properties": {
        "sampler": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        "type": { "enum": ["default"] },
        "value": { "enum": [""] }
      }
    },
    "texture": {
      "oneOf": [
        { "$ref": "#/definitions/resourceTexture" },
        { "$ref": "#/definitions/defaultTexture" }
      ]
    },
    "textureCollection": {
      "oneOf": [
        { "$ref": "#/definitions/texture" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/texture" }
        }
      ]
    },
    "textures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Texture": { "$ref": "#/definitions/textureCollection" }
      }
    },
    "defaultDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Textures"],
      "properties": {
        "Textures": { "$ref": "#/definitions/textures" }
      }
    },
    "specializedDefinition": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/definition" },
        { "required": ["factory"] }
      ]
    },
    "definition": {
      "oneOf": [
        { "$ref": "#/definitions/defaultDefinition" },
        { "$ref": "#/definitions/specializedDefinition" }
      ]
    },
    "definitionCollection": {
      "oneOf": [
        { "$ref": "#/definitions/defaultDefinition" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/definition" },
          "contains": { "$ref": "#/definitions/defaultDefinition" }
        }
      ]
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Definition"],
      "properties": {
        "Definition": { "$ref": "#/definitions/definitionCollection" }
      }
    },
    "programDependency": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/dependentResource" },
        {
          "required": ["id"],
          "properties": {
            "id": { "enum": ["Program"] },
            "ref": {
              "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString",
              "x-willpower-editor-version": "1.0",
              "x-willpower-widget": "resource-reference",
              "x-willpower-allowed-resource-types": ["Program"],
              "x-willpower-reference-scope": "manifest"
            }
          }
        }
      ]
    },
    "dependencyCollection": {
      "oneOf": [
        { "$ref": "#/definitions/programDependency" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/dependentResource"
          },
          "contains": { "$ref": "#/definitions/programDependency" }
        }
      ]
    },
    "dependentResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DependentResource"],
      "properties": {
        "DependentResource": { "$ref": "#/definitions/dependencyCollection" }
      }
    },
    "resource": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/resource" },
        {
          "required": ["name", "DependentResources", "Definitions"],
          "properties": {
            "type": { "enum": ["Material"] },
            "DependentResources": { "$ref": "#/definitions/dependentResources" },
            "Definitions": { "$ref": "#/definitions/definitions" }
          },
          "not": {
            "anyOf": [
              { "required": ["location"] },
              { "required": ["Option"] }
            ]
          }
        }
      ]
    }
  }
}
