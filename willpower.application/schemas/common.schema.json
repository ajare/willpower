{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.willpower.dev/resource-manifest/common.schema.json",
  "title": "Resource Manifest common definitions",
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+$"
    },
    "scalar": {
      "type": ["string", "number", "integer", "boolean"]
    },
    "unsignedInteger": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+$" }
      ]
    },
    "integer": {
      "anyOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^[+-]?[0-9]+$" }
      ]
    },
    "number": {
      "anyOf": [
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        }
      ]
    },
    "boolean": {
      "anyOf": [
        { "type": "boolean" },
        {
          "type": "string",
          "pattern": "^(?:[Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee]|[Yy][Ee][Ss]|[Nn][Oo]|1|0)$"
        }
      ]
    }
  }
}
