{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.willpower.dev/resource-manifest/image.schema.json",
  "title": "Image Resource",
  "$ref": "#/definitions/resource",
  "definitions": {
    "defaultDefinition": {
      "type": "object",
      "additionalProperties": false
    },
    "definition": {
      "oneOf": [
        { "$ref": "#/definitions/defaultDefinition" },
        {
          "allOf": [
            { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/definition" },
            { "required": ["factory"] }
          ]
        }
      ]
    },
    "definitionCollection": {
      "oneOf": [
        { "$ref": "#/definitions/definition" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/definition" }
        }
      ]
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Definition"],
      "properties": {
        "Definition": { "$ref": "#/definitions/definitionCollection" }
      }
    },
    "option": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": { "enum": ["filtering"] },
            "value": {
              "enum": ["none", "linear"],
              "x-willpower-editor-version": "1.0",
              "x-willpower-editor-default": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": { "enum": ["uv-style"] },
            "value": {
              "enum": ["atlas"],
              "x-willpower-editor-version": "1.0",
              "x-willpower-editor-default": "atlas"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": { "enum": ["colour-space"] },
            "value": {
              "enum": ["linear"],
              "x-willpower-editor-version": "1.0",
              "x-willpower-editor-default": "linear"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": { "enum": ["wrapping"] },
            "value": {
              "enum": ["repeat"],
              "x-willpower-editor-version": "1.0",
              "x-willpower-editor-default": "repeat"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": { "enum": ["mipmaps"] },
            "value": {
              "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/boolean",
              "x-willpower-editor-version": "1.0",
              "x-willpower-editor-default": true
            }
          }
        }
      ]
    },
    "optionCollection": {
      "oneOf": [
        { "$ref": "#/definitions/option" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/option" }
        }
      ]
    },
    "resource": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/resource" },
        {
          "required": ["location"],
          "properties": {
            "type": { "enum": ["Image"] },
            "location": {
              "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString",
              "x-willpower-editor-version": "1.0",
              "x-willpower-widget": "file",
              "x-willpower-file-kind": "Images",
              "x-willpower-file-extensions": ["png", "jpg", "jpeg", "bmp", "tga"]
            },
            "Option": { "$ref": "#/definitions/optionCollection" },
            "Definitions": { "$ref": "#/definitions/definitions" }
          },
          "not": { "required": ["DependentResources"] }
        }
      ]
    }
  }
}
