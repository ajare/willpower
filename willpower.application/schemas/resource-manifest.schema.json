{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.willpower.dev/resource-manifest/resource-manifest.schema.json",
  "title": "Resource Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["Resources"],
  "properties": {
    "Resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Resource": {
          "$ref": "#/definitions/resourceCollection"
        },
        "Namespace": {
          "oneOf": [
            { "$ref": "#/definitions/namespace" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/namespace" }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "resource": {
      "oneOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/text-file.schema.json#/definitions/resource" },
        { "$ref": "https://schemas.willpower.dev/resource-manifest/xml-file.schema.json#/definitions/resource" },
        { "$ref": "https://schemas.willpower.dev/resource-manifest/shader.schema.json#/definitions/resource" },
        { "$ref": "https://schemas.willpower.dev/resource-manifest/audio-bank.schema.json#/definitions/resource" },
        { "$ref": "https://schemas.willpower.dev/resource-manifest/image.schema.json#/definitions/resource" },
        { "$ref": "https://schemas.willpower.dev/resource-manifest/image-set.schema.json#/definitions/resource" },
        { "$ref": "https://schemas.willpower.dev/resource-manifest/animation-set.schema.json#/definitions/resource" },
        {
          "allOf": [
            { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/resource" },
            {
              "properties": {
                "type": {
                  "not": {
                    "enum": ["TextFile", "XmlFile", "Shader", "AudioBank", "Image", "ImageSet", "AnimationSet"]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "resourceCollection": {
      "oneOf": [
        { "$ref": "#/definitions/resource" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/resource" }
        }
      ]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "Resource"],
      "properties": {
        "name": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        "Resource": {
          "$ref": "#/definitions/resourceCollection"
        }
      }
    }
  }
}
