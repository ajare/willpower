{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.willpower.dev/resource-manifest/resource-manifest.schema.json",
  "title": "Resource Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["Resources"],
  "properties": {
    "Resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Resource": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/resourceCollection"
        },
        "Namespace": {
          "oneOf": [
            { "$ref": "#/definitions/namespace" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/namespace" }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "Resource"],
      "properties": {
        "name": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
        },
        "Resource": {
          "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/resourceCollection"
        }
      }
    }
  }
}
